# 复制为 deploy/.env 后填写；不要将真实密码提交到版本库。

TZ=UTC

# MySQL 8.4
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=tizhen
MYSQL_USER=tizhen
MYSQL_PASSWORD=replace-with-strong-app-password
MYSQL_PORT=3306

# Redis 7.4
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_PORT=6379

# 首次启动引导创建超级管理员；仅当 admin_user 为空时生效。
# 生产环境请配置强密码，或在已有管理员后清空这两项。
TIZHEN_BOOTSTRAP_ADMIN_USERNAME=
TIZHEN_BOOTSTRAP_ADMIN_PASSWORD=
TIZHEN_BOOTSTRAP_ADMIN_DISPLAY_NAME=超级管理员

# go-judge 沙箱服务地址（worker 使用）。
GO_JUDGE_URL=http://127.0.0.1:5050

# 平台 LLM：简答题判分使用 OpenAI Chat Completions 兼容接口。
# 未配置时简答提交会以 failed 结束，不影响其他题型。
PLATFORM_LLM_BASE_URL=
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=

# AI 造数据选手凭证加密密钥：Base64 编码的 32 字节随机值。
# 生成方式：openssl rand -base64 32
# app 与 worker 必须使用同一个密钥；留空时 LLM 凭证相关接口不可用。
LLM_CREDENTIAL_ENCRYPTION_KEY=
